# ── Python ─────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Git ─────────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Secrets ─────────────────────────────────────────────────────────────────────
.env
.env.*

# ── Large data files (mounted as volume at runtime) ───────────────────────────
# (Removed ignores so these can be packaged into the cloud image)

# ── Jupyter / notebooks ────────────────────────────────────────────────────────
notebooks/
*.ipynb

# ── Dev artefacts ─────────────────────────────────────────────────────────────
scratch/
outputs/
logs/
*.log

# ── Qdrant local storage (mounted as volume) ──────────────────────────────────
qdrant_storage/

# ── Docs & CI ─────────────────────────────────────────────────────────────────
*.md
*.txt
!requirements.txt
Makefile
frontend/node_modules/
